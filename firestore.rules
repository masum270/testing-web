rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /team_members/{email} { allow read, write: if true; }
    match /questions/{id} { allow read: if true; allow write: if request.auth != null; }
    match /exam_sessions/{id} { allow read, write: if true; }
    match /exam_results/{id} { allow read: if true; allow write: if true; }
    match /users/{userId} {
      allow read, write: if true;
      match /exams/{examId} { allow read, write: if true; }
    }
    match /admin_logs/{id} { allow read, write: if true; }
    match /security_logs/{id} { allow read, write: if true; }
    match /password_reset_codes/{id} { allow read: if true; allow write: if true; }
    match /email_verify_codes/{id} { allow read: if true; allow write: if true; }
    match /email_change_codes/{id} { allow read: if true; allow write: if true; }
    match /ai_questions_queue/{id} { allow read, write: if true; }
    match /ai_generation_logs/{id} { allow read, write: if true; }
    match /login_history/{id} { allow read, write: if true; }
    match /user_streaks/{id} { allow read, write: if true; }
    match /mega_exams/{id} { allow read: if true; allow write: if true; }
    match /mega_exam_results/{id} { allow read: if true; allow write: if true; }
    match /chapter_photos/{id} { allow read: if true; allow write: if true; }
    match /leaderboard/{id} { allow read: if true; allow write: if true; }
    match /ai_daily_stats/{id} { allow read, write: if true; }
    match /ai_control/{id} { allow read, write: if true; }
    match /ai_prompts_config/{id} { allow read, write: if true; }
  }
}
