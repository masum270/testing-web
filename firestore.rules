rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    match /password_reset_codes/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /email_verify_codes/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /email_change_codes/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /exam_results/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /leaderboard/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /questions/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /chapter_photos/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /ai_questions_queue/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /ai_generation_logs/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /ai_daily_stats/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /ai_control/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /ai_prompts_config/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /mega_exams/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /mega_exam_results/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /user_streaks/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /users/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /login_history/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
